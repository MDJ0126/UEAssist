<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidUEAssistPackage">
    <Groups>
      <Group guid="guidUEAssistCommandSet" id="UEAssistCommandGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidUEAssistCommandSet" id="GoToSymbolCommandId" priority="0x0100" type="Button">
        <Parent guid="guidUEAssistCommandSet" id="UEAssistCommandGroup" />
        <Strings>
          <ButtonText>UEAssist: Go to Symbol</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidUEAssistCommandSet" id="StatusCommandId" priority="0x0110" type="Button">
        <Parent guid="guidUEAssistCommandSet" id="UEAssistCommandGroup" />
        <Strings>
          <ButtonText>UEAssist: Status</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidUEAssistCommandSet" id="FindReferencesCommandId" priority="0x0108" type="Button">
        <Parent guid="guidUEAssistCommandSet" id="UEAssistCommandGroup" />
        <Strings>
          <ButtonText>UEAssist: Find References</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidUEAssistCommandSet" id="GoToSymbolCommandId" editor="guidVSStd97" key1="VK_F12" />
    <KeyBinding guid="guidUEAssistCommandSet" id="GoToSymbolCommandId" editor="guidVSStd97" key1="G" mod1="ALT" />
    <KeyBinding guid="guidUEAssistCommandSet" id="FindReferencesCommandId" editor="guidVSStd97" key1="VK_F12" mod1="SHIFT" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidUEAssistPackage" value="{28053c53-4f17-4fe3-9f58-b4f3cf573bad}" />
    <GuidSymbol name="guidUEAssistCommandSet" value="{f9d77864-fac8-457e-bd4f-552715151b6c}">
      <IDSymbol name="UEAssistCommandGroup" value="0x1020" />
      <IDSymbol name="GoToSymbolCommandId" value="0x0100" />
      <IDSymbol name="StatusCommandId" value="0x0101" />
      <IDSymbol name="FindReferencesCommandId" value="0x0102" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
